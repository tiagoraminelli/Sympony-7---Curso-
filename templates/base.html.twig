<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>
      {% block title %}
        Welcome!
      {% endblock %}
    </title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>:D</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>" />

    {# Bootstrap CSS CDN #}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    {% block stylesheets %}
      <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
      <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
    {% endblock %}

    {% block javascripts %}
      <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
      {% block importmap %}
        {{ importmap('app') }}
      {% endblock %}

      <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
      <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    {% endblock %}

    {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
    {% if frankenphpHotReload %}
      <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}" />
      <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
      <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
    {% endif %}
  </head>

  <body class="bg-light">
    {# ============================================ #}
    {# NAVBAR #}
    {# ============================================ #}
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
      <div class="container">
        <a class="navbar-brand" href="{{ path('app_home') }}">Inventario</a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"><span class="navbar-toggler-icon"></span></button>

        <div class="collapse navbar-collapse" id="navbarContent">
          <ul class="navbar-nav me-auto mb-2 mb-lg-0">
            {# Usuarios #}
            <li class="nav-item">
              <a class="nav-link {{ app.request.get('_route') starts with 'app_users' ? 'active' : '' }}" href="{{ path('app_users_index') }}"><i class="bi bi-people"></i> Usuarios</a>
            </li>

            {# Clientes #}
            <li class="nav-item">
              <a class="nav-link {{ app.request.get('_route') starts with 'app_clientes' ? 'active' : '' }}" href="{{ path('app_clientes_index') }}"><i class="bi bi-person"></i> Clientes</a>
            </li>

            {# Productos #}
            <li class="nav-item">
              <a class="nav-link {{ app.request.get('_route') starts with 'app_productos' ? 'active' : '' }}" href="{{ path('app_productos_index') }}"><i class="bi bi-box-seam"></i> Productos</a>
            </li>

            {# Categorías #}
            <li class="nav-item">
              <a class="nav-link {{ app.request.get('_route') starts with 'app_categoria' ? 'active' : '' }}" href="{{ path('app_categoria_index') }}"><i class="bi bi-tags"></i> Categorías</a>
            </li>

            {# Proveedores #}
            <li class="nav-item">
              <a class="nav-link {{ app.request.get('_route') starts with 'app_proveedores' ? 'active' : '' }}" href="{{ path('app_proveedores_index') }}"><i class="bi bi-truck"></i> Proveedores</a>
            </li>

            {# Presupuestos - Dropdown #}
            <li class="nav-item dropdown">
              <a class="nav-link dropdown-toggle {{ app.request.get('_route') starts with 'app_presupuestos' ? 'active' : '' }}" href="#" id="presupuestosDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-file-text"></i> Presupuestos</a>
              <ul class="dropdown-menu" aria-labelledby="presupuestosDropdown">
                <li>
                  <a class="dropdown-item {{ app.request.get('_route') == 'app_presupuestos_index' ? 'active' : '' }}" href="{{ path('app_presupuestos_index') }}"><i class="bi bi-list-ul"></i> Listado</a>
                </li>
                <li>
                  <a class="dropdown-item {{ app.request.get('_route') == 'app_presupuestos_new' ? 'active' : '' }}" href="{{ path('app_presupuestos_new') }}"><i class="bi bi-plus-circle"></i> Nuevo</a>
                </li>
                <li>
                  <a class="dropdown-item {{ app.request.get('_route') starts with 'app_presupuestos_detalle' ? 'active' : '' }}" href="{{ path('app_presupuestos_detalle_index') }}"><i class="bi bi-receipt"></i> Detalle</a>
                </li>
              </ul>
            </li>
          </ul>

          {# Usuario logueado #}
          <ul class="navbar-nav">
            {% if app.user %}
              <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown"><i class="bi bi-person-circle"></i> {{ app.user.name ?? app.user.email }}</a>
                <ul class="dropdown-menu dropdown-menu-end">
                  <li>
                    <a class="dropdown-item" href="{{ path('app_users_show', { id: app.user.id }) }}"><i class="bi bi-person"></i> Mi Perfil</a>
                  </li>
                  <li>
                    <hr class="dropdown-divider" />
                  </li>
                  <li>
                    <a class="dropdown-item text-danger" href="#"><i class="bi bi-box-arrow-right"></i> Cerrar Sesión</a>
                  </li>
                </ul>
              </li>
            {% else %}
              <li class="nav-item">
                <a class="nav-link" href="#"><i class="bi bi-box-arrow-in-right"></i> Login</a>
              </li>
              <li class="nav-item">
                <a class="nav-link" href="#"><i class="bi bi-person-plus"></i> Registro</a>
              </li>
            {% endif %}
          </ul>
        </div>
      </div>
    </nav>

    {# ============================================ #}
    {# BREADCRUMB #}
    {# ============================================ #}
    <div class="container">
      {% if breadcrumbs is defined and (breadcrumbs|length) > 0 %}
        <nav aria-label="breadcrumb" class="mb-4">
          <ol class="breadcrumb">
            <li class="breadcrumb-item">
              <a href="{{ path('app_home') }}">Inicio</a>
            </li>
            {% for crumb in breadcrumbs %}
              {% if crumb.url %}
                <li class="breadcrumb-item">
                  <a href="{{ crumb.url }}">{{ crumb.label }}</a>
                </li>
              {% else %}
                <li class="breadcrumb-item active" aria-current="page">{{ crumb.label }}</li>
              {% endif %}
            {% endfor %}
          </ol>
        </nav>
      {% endif %}
    </div>

    {# ============================================ #}
    {# CONTENIDO PRINCIPAL #}
    {# ============================================ #}
    <div class="container">
      {% block body %}

      {% endblock %}
    </div>

    {# Modal de eliminación global #}
    {{ include('_delete_modal.html.twig') }}

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        const deleteModal = document.getElementById('deleteModal')
        const deleteForm = document.getElementById('deleteForm')
        const deleteItemName = document.getElementById('deleteItemName')
        const deleteToken = document.getElementById('deleteToken')

        document.querySelectorAll('[data-delete]').forEach((button) => {
          button.addEventListener('click', function (e) {
            e.preventDefault()

            const id = this.getAttribute('data-id')
            const name = this.getAttribute('data-name')
            let url = this.getAttribute('data-url')
            const token = this.getAttribute('data-token')

            url = url.replace('ID_PLACEHOLDER', id)

            deleteItemName.textContent = name
            deleteForm.action = url
            deleteToken.value = token

            const modal = new bootstrap.Modal(deleteModal)
            modal.show()
          })
        })
      })
    </script>
  </body>
</html>
