<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <title>Listado de Productos</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Arial', sans-serif;
        padding: 20px;
        background: white;
      }

      .header {
        border-bottom: 2px solid #000;
        padding-bottom: 15px;
        margin-bottom: 20px;
      }

      .header h1 {
        font-size: 24px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .header .fecha {
        font-size: 12px;
        color: #666;
        margin-top: 5px;
      }

      .filtros {
        background: #f5f5f5;
        padding: 10px 15px;
        margin-bottom: 20px;
        font-size: 12px;
        border-left: 3px solid #000;
      }

      .filtros strong {
        font-weight: bold;
      }

      .producto-item {
        border: 1px solid #ddd;
        padding: 15px;
        margin-bottom: 15px;
        page-break-inside: avoid;
      }

      .producto-item .row {
        display: flex;
        gap: 20px;
        align-items: center;
      }

      .producto-item .info {
        flex: 1;
      }

      .producto-item .info .nombre {
        font-size: 16px;
        font-weight: bold;
        color: #000;
      }

      .producto-item .info .detalle {
        font-size: 12px;
        color: #666;
        margin-top: 5px;
      }

      .producto-item .info .detalle span {
        display: inline-block;
        margin-right: 15px;
      }

      .producto-item .barcode {
        text-align: center;
        min-width: 150px;
      }

      .producto-item .barcode img {
        max-width: 150px;
        max-height: 60px;
      }

      .producto-item .barcode .codigo {
        font-size: 11px;
        font-family: 'Courier New', monospace;
        color: #333;
        margin-top: 3px;
      }

      .footer {
        text-align: center;
        font-size: 10px;
        color: #999;
        border-top: 1px solid #ddd;
        padding-top: 15px;
        margin-top: 20px;
      }

      @page {
        margin: 15px;
      }

      @media print {
        body {
          padding: 0;
        }
        .producto-item {
          border-color: #ccc;
        }
      }
    </style>
  </head>
  <body>
    <div class="header">
      <h1>Listado de Productos</h1>
      <div class="fecha">Generado: {{ fecha }}</div>
    </div>

    <div class="filtros">
      <strong>Filtros aplicados:</strong>
      {% if filtros.search %}
        Búsqueda: "{{ filtros.search }}" |
      {% endif %}Categoría: {{ filtros.categoria }}
    </div>

    <div class="productos-list">
      {% for producto in productos %}
        <div class="producto-item">
          <div class="row">
            <div class="info">
              <div class="nombre">{{ producto.nombre }}</div>
              <div class="detalle">
                <span><strong>ID:</strong> {{ producto.id }}</span>
                <span><strong>Código:</strong> {{ producto.codigoBarra ? : 'Sin código' }}</span>
                <span><strong>Categoría:</strong> {{ producto.categoria ? producto.categoria.nombre : 'Sin categoría' }}</span>
                <span><strong>Precio:</strong> ${{ producto.precio|number_format(2, ',', '.') }}</span>
                <span><strong>Stock:</strong> {{ producto.stock|number_format(3, ',', '.') }}</span>
              </div>
              {% if producto.descripcion %}
                <div style="font-size: 11px; color: #888; margin-top: 3px;">{{ producto.descripcion }}</div>
              {% endif %}
            </div>
            <div class="barcode">
              {% if producto.codigoBarra %}
                <img src="data:image/svg+xml;base64,{{ barcode_data[producto.id]|default('') }}" alt="Código de barras" />
                <div class="codigo">{{ producto.codigoBarra }}</div>
              {% else %}
                <div style="font-size: 10px; color: #999;">Sin código</div>
              {% endif %}
            </div>
          </div>
        </div>
      {% else %}
        <div style="text-align: center; padding: 40px; color: #999;">No hay productos para mostrar</div>
      {% endfor %}
    </div>

    <div class="footer">Total de productos: {{ productos|length }} | Generado desde Sistema de Inventario</div>
  </body>
</html>
